# Exact public origin, e.g. https://sky-x.az. Required for production email.
CONTACT_ORIGIN=
# Blank or resend for the real adapter. test only works in development/test.
CONTACT_TRANSPORT=
RESEND_API_KEY=
# Verified sender address on the Resend account.
CONTACT_FROM=
# Required in production. Site-wide limit if the trusted IP header is blank.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Optional. Configure ONLY if the hosting proxy overwrites this single-IP header.
CONTACT_TRUSTED_IP_HEADER=

# Set true only for the reviewed public launch; rebuild after changing this value.
SITE_INDEXABLE=
